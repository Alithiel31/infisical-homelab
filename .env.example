# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais commiter le .env (voir .gitignore).

# Mot de passe du user Postgres applicatif (infisical_app) sur l'instance Postgres mutualisée
DB_PASSWORD=change-me

# Adresse du Postgres mutualisé. En bridge Docker par défaut (pas de réseau custom),
# c'est en général la passerelle du bridge (souvent 172.17.0.1) — vérifier avec
# `docker network inspect bridge` si besoin.
DB_HOST=172.17.0.1

# Clé de chiffrement Infisical (secrets au repos) — critique, à générer une seule fois
# et à sauvegarder ailleurs (perte = secrets illisibles dans Postgres).
# Génération : openssl rand -hex 16
ENCRYPTION_KEY=change-me

# Secret de signature des sessions/JWT.
# Génération : openssl rand -base64 32
AUTH_SECRET=change-me

# URL publique d'Infisical (adresse Tailscale), ex: http://caesura.<tailnet>.ts.net:8090
INFISICAL_SITE_URL=http://caesura.<tailnet>.ts.net:8090
